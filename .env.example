# ════════════════════════════════════════════════════════════════════════
# ai_backtest_model —— 环境配置模板
# 复制为 `.env` 后按实际环境修改（.env 不要提交到版本库）
# ════════════════════════════════════════════════════════════════════════

# ── 数据库连接 ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=stock_db
DB_CHARSET=utf8mb4

# ── 数据表映射 ──────────────────────────────────────────────────────────
# 日线后复权表
TABLE_BACKWARD_DAILY=backward_daily
# 月线后复权表
TABLE_BACKWARD_MONTHLY=backward_monthly

# ── 导入器默认参数 ──────────────────────────────────────────────────────
# baostock 复权口径：1=后复权(hfq) 2=前复权(qfq) 3=不复权(raw)
IMPORT_ADJUST_FLAG=1
# 日线默认起始日期 / 月线默认起始日期
IMPORT_DAILY_START=2021-06-01
IMPORT_MONTHLY_START=2015-01-01
# 导入并发线程数（baostock 为单连接串行，>1 时自动串行化）
IMPORT_WORKERS=4
